# Keys, one variable per key. The suffix after MCP_CIPHER_KEY_ is the key id, recorded
# next to every value it seals so a later rotation knows what to re-encrypt.
#
# Generate one:  openssl rand -base64 32
MCP_CIPHER_KEY_V1=

# Which key new values are sealed under. Optional when only one key is configured.
MCP_CIPHER_ACTIVE_KEY=v1

# Shared secret callers present as x-cipher-token metadata. Empty disables the check,
# which is only defensible on a loopback address.
MCP_CIPHER_TOKEN=

# Loopback by default: reachable from the machines that need it and nowhere else.
MCP_CIPHER_ADDRESS=127.0.0.1:9090

# Credentials for mcp-config, which refuses an anonymous caller. Copy the pair from
# mcp-config/.env.
CONFIG_USER=
CONFIG_PASSWORD=
